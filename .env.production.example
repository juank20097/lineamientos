# Copiar a .env.production y completar con valores reales. NUNCA commitear
# .env.production con secretos reales al repositorio.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=lineamientos.iess.gob.ec

# PostgreSQL (el host "db" es el nombre del servicio en docker-compose.yml)
POSTGRES_DB=sis_lineamientos
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Playwright - dentro del contenedor ya se instalo Chromium via `playwright install`
ZNUNY_PYTHON=python

# PDF - Firmas de responsabilidad
PDF_REVISADO_NOMBRE=
PDF_REVISADO_CARGO=
PDF_APROBADO_NOMBRE=
PDF_APROBADO_CARGO=

# FirmaEC - Web Service de Firma Electronica (IESS)
FIRMA_EC_URL=
FIRMA_EC_ENLACES_URL=
FIRMA_EC_CLAVE_PUBLICA_URL=

# Email (notificacion de firma de autoridad pendiente)
EMAIL_HOST=mail.iess.gob.ec
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=lineamientos@iess.gob.ec
